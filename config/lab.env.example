# Copy to config/lab.env and set real values. config/lab.env is git-ignored.
# One password is used for root/oracle OS users, SYS/SYSTEM, SYSMAN, WebLogic and agent registration.
# EM requires: 8+ chars, upper + lower + digit; use only letters, digits and _ # $
LAB_PWD=ChangeMe_2024

# Windows host paths (~ is expanded to %USERPROFILE%)
LAB_SSH_KEY=~/.ssh/oem24_ed25519
LAB_DOWNLOADS=~/Downloads
LAB_VM_DIR=~/VirtualBox VMs
LAB_ISO_DIR=~/VirtualBox VMs/iso

# Installer file names expected in LAB_DOWNLOADS
DB_HOME_ZIP=LINUX.X64_2326100_db_home.zip
EM_ZIPS=V1046951-01.zip,V1046952-01.zip,V1046953-01.zip,V1046954-01.zip,V1046955-01.zip
OL_BOOT_ISO_URL=https://yum.oracle.com/ISOS/OracleLinux/OL9/u8/x86_64/OracleLinux-R9-U8-x86_64-boot.iso

# VM sizing (MB)
OEM24_MEM_MB=12288
DG_MEM_MB=4096
